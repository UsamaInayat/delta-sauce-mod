SESSION_SECRET="change-me-in-production-use-long-random-string"
OPENSEA_PROXY_URL="https://sauce.deltasauceartist.workers.dev"
ENS_RESOLVE_URL="https://api.ensideas.com/ens/resolve"
CRON_SECRET="optional-bearer-token-for-cron-endpoint"
