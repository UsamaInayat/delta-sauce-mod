# Local dev — use your Postgres URL for both vars
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deltasauce_raffles?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deltasauce_raffles?schema=public"

# Vercel Postgres (auto-injected — no manual setup needed if using prepare-db-env.mjs)
# POSTGRES_PRISMA_URL=   # pooled — used as DATABASE_URL
# POSTGRES_URL=          # direct — used as DIRECT_DATABASE_URL

ADMIN_USERNAME="sauce"
